<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Data Barang</title>

  <style>
    body {
      font-family: Arial;
      background: #f0f0f0;
      margin: 0;
      padding: 10px;
    }

    h2 {
      text-align: center;
    }

    .box {
      background: white;
      padding: 15px;
      margin: 10px;
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    input {
      width: 100%;
      padding: 10px;
      margin-top: 5px;
      border-radius: 5px;
      border: 1px solid #ccc;
    }

    button {
      width: 100%;
      padding: 10px;
      margin-top: 10px;
      border: none;
      border-radius: 5px;
      background: #007bff;
      color: white;
      font-size: 16px;
    }

    li {
      background: #eee;
      padding: 10px;
      margin-top: 5px;
      border-radius: 5px;
      display: flex;
      justify-content: space-between;
    }

    .hapus {
      background: red;
      color: white;
      border: none;
      border-radius: 5px;
      padding: 5px 10px;
    }
  </style>
</head>

<body>

  <h2>📦 Data Barang</h2>

  <div class="box">
    <input type="text" id="nama" placeholder="Masukkan nama barang">
    <button onclick="tambah()">Tambah</button>
  </div>

  <div class="box">
    <h3>List Barang</h3>
    <ul id="list"></ul>
  </div>

  <script>
    let data = JSON.parse(localStorage.getItem("barang")) || [];

    function tampilkan() {
      let list = document.getElementById("list");
      list.innerHTML = "";

      data.forEach((item, index) => {
        let li = document.createElement("li");
        li.innerHTML = item + 
        ' <button class="hapus" onclick="hapus(' + index + ')">X</button>';
        list.appendChild(li);
      });
    }

    function tambah() {
      let nama = document.getElementById("nama").value;

      if (nama === "") {
        alert("Isi dulu!");
        return;
      }

      data.push(nama);
      localStorage.setItem("barang", JSON.stringify(data));
      document.getElementById("nama").value = "";

      tampilkan();
    }

    function hapus(index) {
      data.splice(index, 1);
      localStorage.setItem("barang", JSON.stringify(data));
      tampilkan();
    }

    tampilkan();
  </script>

</body>
</html>
